{% liquid
  assign video = section.settings.video
  assign section_height = section.settings.section_height
  assign section_height_mobile = section.settings.section_height_mobile | default: section.settings.section_height
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0

  comment
    Calculate desktop height
  endcomment
  if section_height == 'custom'
    assign desktop_height = section.settings.section_height_custom | append: 'svh'
  elsif section_height == 'full-screen'
    assign desktop_height = '100svh'
  else
    assign desktop_height = 'var(--section-height-' | append: section_height | append: ')'
  endif

  comment
    Calculate mobile height
  endcomment
  if section_height_mobile == 'custom'
    assign mobile_height = section.settings.section_height_custom_mobile | append: 'svh'
  elsif section_height_mobile == 'full-screen'
    assign mobile_height = '100svh'
  else
    assign mobile_height = 'var(--section-height-' | append: section_height_mobile | append: ')'
  endif
%}

<div
  id="VideoHeroBanner-{{ section.id }}"
  class="video-hero-banner color-{{ section.settings.color_scheme }}{% if section.settings.section_height == 'full-screen' %} video-hero-banner--full-screen{% endif %}"
  style="
    --section-min-height-desktop: {{ desktop_height }};
    --section-min-height-mobile: {{ mobile_height }};
    --overlay-opacity: {{ overlay_opacity }};
  "
>
  <div class="video-hero-banner__container section section--full-width">
    <div class="video-hero-banner__video-wrapper">
      {% if video != blank %}
        {{
          video
          | video_tag:
            poster: nil,
            autoplay: true,
            loop: true,
            controls: false,
            muted: true,
            playsinline: true,
            class: 'video-hero-banner__video',
            data-testid: 'video-hero-banner-video'
        }}
      {% else %}
        <div class="video-hero-banner__placeholder">
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'video-hero-banner__placeholder-svg' }}
          <p class="video-hero-banner__placeholder-text">Upload a video to display in the hero banner</p>
        </div>
      {% endif %}
      {% if section.settings.show_overlay %}
        <div class="video-hero-banner__overlay"></div>
      {% endif %}
    </div>

    {% comment %} Content Area {% endcomment %}
    {% if section.blocks.size > 0 %}
      {% liquid
        assign text_align_flex = 'center'
        if section.settings.text_alignment == 'left'
          assign text_align_flex = 'flex-start'
        elsif section.settings.text_alignment == 'right'
          assign text_align_flex = 'flex-end'
        endif
      %}
      <div class="video-hero-banner__content" style="align-items: {{ section.settings.content_alignment }}; {% render 'spacing-style', settings: section.settings %}">
        <div class="video-hero-banner__content-inner" style="align-items: {{ text_align_flex }}; text-align: {{ section.settings.text_alignment }};">
          {% content_for 'blocks' %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .video-hero-banner {
    position: relative;
    min-height: var(--section-min-height-mobile);
    width: 100%;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .video-hero-banner {
      min-height: var(--section-min-height-desktop);
    }
  }

  .video-hero-banner__container {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-hero-banner__video-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: rgb(var(--color-background));
  }

  .video-hero-banner__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    position: absolute;
    inset: 0;
    pointer-events: none;
    will-change: transform;
  }

  .video-hero-banner--full-screen .video-hero-banner__video {
    object-fit: cover;
  }

  .video-hero-banner__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--overlay-opacity));
    pointer-events: none;
    z-index: 1;
  }

  .video-hero-banner__content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: var(--section-padding-block-start, 2rem) var(--section-padding-inline-start, 1.5rem) var(--section-padding-block-end, 2rem) var(--section-padding-inline-end, 1.5rem);
    z-index: 2;
  }

  .video-hero-banner__content-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    max-width: var(--page-width, 1200px);
  }

  /* Apply text-align to text content and ensure blocks respect alignment */
  .video-hero-banner__content-inner > * {
    text-align: inherit;
  }

  /* Override block alignment to respect section-level text alignment */
  /* Force text blocks to use section alignment regardless of block settings */
  .video-hero-banner__content-inner .text-block {
    --text-align: inherit !important;
    --horizontal-alignment: inherit !important;
    --text-align-default: inherit !important;
    align-items: inherit !important;
  }

  /* Force text block children to use section alignment */
  .video-hero-banner__content-inner .text-block > * {
    text-align: inherit !important;
  }

  /* Override any inline styles that might set alignment */
  .video-hero-banner__content-inner .text-block[style*="--text-align"] {
    --text-align: inherit !important;
  }

  .video-hero-banner__content-inner .text-block[style*="--horizontal-alignment"] {
    --horizontal-alignment: inherit !important;
  }

  /* Ensure buttons align with text alignment */
  .video-hero-banner__content-inner > a,
  .video-hero-banner__content-inner .button-block {
    align-self: inherit;
  }

  .video-hero-banner__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgb(var(--color-background) / 0.5);
    color: rgb(var(--color-foreground));
    gap: 1rem;
  }

  .video-hero-banner__placeholder-svg {
    width: 200px;
    height: 200px;
    opacity: 0.3;
  }

  .video-hero-banner__placeholder-text {
    font-size: 0.875rem;
    opacity: 0.7;
  }

  /* Ensure content blocks are interactive */
  .video-hero-banner__content {
    pointer-events: none;
  }

  .video-hero-banner__content * {
    pointer-events: auto;
  }

  @media screen and (max-width: 749px) {
    .video-hero-banner__content {
      padding: var(--section-padding-block-start, 1.5rem) var(--section-padding-inline-start, 1rem) var(--section-padding-block-end, 1.5rem) var(--section-padding-inline-end, 1rem);
    }

    /* Show full video on mobile instead of cropping */
    .video-hero-banner__video {
      object-fit: contain;
      object-position: center center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video Hero Banner",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Hero Video",
      "info": "Upload a video to display as the hero banner. It will autoplay, loop, and be muted."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full-screen",
          "label": "Full Screen"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "Custom Height (Desktop)",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "svh",
      "default": 80,
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Mobile Layout"
    },
    {
      "type": "select",
      "id": "section_height_mobile",
      "label": "Section Height (Mobile)",
      "info": "Set a different height for mobile devices",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full-screen",
          "label": "Full Screen"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "section_height_custom_mobile",
      "label": "Custom Height (Mobile)",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "svh",
      "default": 50,
      "visible_if": "{{ section.settings.section_height_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Vertical Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show Dark Overlay",
      "default": false,
      "info": "Adds a dark overlay on the video for better text readability"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30,
      "visible_if": "{{ section.settings.show_overlay }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "text"
    },
    {
      "type": "button"
    }
  ],
  "presets": [
    {
      "name": "Video Hero Banner",
      "category": "Banners",
      "blocks": {
        "heading": {
          "type": "text",
          "name": "Heading",
          "settings": {
            "text": "<h1>Welcome to Our Store</h1>",
            "type_preset": "h1",
            "max_width": "normal",
            "alignment": "center",
            "width": "100%"
          }
        },
        "button": {
          "type": "button",
          "name": "Button",
          "settings": {
            "label": "Shop Now",
            "link": "shopify://collections/all",
            "style_class": "button"
          }
        }
      },
      "block_order": ["heading", "button"],
      "settings": {
        "section_height": "large",
        "section_height_mobile": "medium",
        "content_alignment": "center",
        "text_alignment": "center",
        "color_scheme": "scheme-1",
        "show_overlay": false,
        "overlay_opacity": 30,
        "padding-block-start": 40,
        "padding-block-end": 40,
        "padding-inline-start": 40,
        "padding-inline-end": 40
      }
    }
  ]
}
{% endschema %}
